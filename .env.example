# Copie este arquivo para ".env" e preencha com os valores reais do seu ambiente.
# NUNCA coloque valores reais aqui: este arquivo vai para o Git. O ".env" está no .gitignore.

# ---------------------------------------------------------------------------
# Execução local (npm run start:dev)
# ---------------------------------------------------------------------------

# String de conexão do PostgreSQL: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/emprestimo_equipamentos?schema=public"

# Porta da API (padrão 3000)
PORT=3000

# development | test | production. Em production o Swagger fica desligado.
NODE_ENV=development

# Chave que assina os tokens JWT. OBRIGATÓRIA, mínimo 32 caracteres, e não pode ser este exemplo.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Duração do token de acesso (curta de propósito) e validade do refresh token, em dias
JWT_EXPIRA_EM=15m
REFRESH_DIAS=7

# Custo do bcrypt (4 a 15). Maior = mais seguro e mais lento. Padrão 12.
BCRYPT_CUSTO=12

# Origens de navegador autorizadas a chamar a API, separadas por vírgula. Vazio = nenhuma.
# Ex.: CORS_ORIGENS=https://meu-front.com,http://localhost:4200
CORS_ORIGENS=

# Endereço público da interface web: vai nos links dos e-mails (recuperação de senha).
# Em desenvolvimento use o endereço do front (ex.: http://localhost:4200 com "npm start"); com o Docker, http://localhost:8080.
# OBRIGATÓRIA em produção e no docker compose.
APP_URL=http://localhost:4200

# Envio de e-mail (SMTP genérico: qualquer provedor). Sem SMTP_HOST, em desenvolvimento o e-mail só é escrito no log
# da API; em produção NÃO é enviado (e o conteúdo, que tem um link equivalente a uma senha, nunca vai para o log).
# Para ver os e-mails em desenvolvimento sem enviar nada: docker compose --profile dev up -d mailpit
#   e use SMTP_HOST=localhost (API local) ou SMTP_HOST=mailpit (API no compose), SMTP_PORTA=1025, e abra http://localhost:8025
# SMTP_HOST=
# SMTP_PORTA=587
# SMTP_SEGURO=false     # true para TLS direto (porta 465)
# SMTP_USUARIO=
# SMTP_SENHA=
# EMAIL_REMETENTE="Empréstimo de Equipamentos <nao-responda@seudominio.com>"

# Cadastro aberto: qualquer pessoa cria a própria conta (sempre como USER) na tela de login. Ligado por padrão.
# CADASTRO_PUBLICO=false deixa só os administradores criarem contas (o link "Criar conta" some do login).
# CADASTRO_PUBLICO=true

# Avisos automáticos por e-mail (lembrete 24h antes do prazo, cobrança de atraso a cada 3 dias e resumo para os
# administradores). Ligados por padrão; precisam do SMTP acima para chegar a alguém.
# NOTIFICACOES_ATIVAS=true
# NOTIFICACOES_CRON="0 8 * * *"        # todo dia às 8h
# NOTIFICACOES_FUSO=America/Sao_Paulo

# Documentação interativa em /docs. Padrão: ligada fora de produção, desligada em produção.
# SWAGGER_ATIVO=true

# ---------------------------------------------------------------------------
# Primeiro administrador (npm run seed). Não existe senha padrão: sem estas variáveis o seed não roda.
# ADMIN_SENHA precisa ter 12+ caracteres, com letras e números.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=Administrador

# ---------------------------------------------------------------------------
# Docker (docker compose up -d --build)
# ---------------------------------------------------------------------------
DB_USER=postgres
DB_SENHA=
DB_NOME=emprestimo_equipamentos
PORTA_API=3000
# Porta da interface web (nginx). A API também é alcançável por ela em /api.
PORTA_WEB=8080
PORTA_MAILPIT=8025

# ---------------------------------------------------------------------------
# Testes de integração (npm run test:e2e)
# Banco EXCLUSIVO para testes: o nome PRECISA conter "test" ou "teste". As tabelas são zeradas a cada execução.
# ---------------------------------------------------------------------------
DATABASE_URL_TESTE="postgresql://postgres:sua_senha@localhost:5432/emprestimo_teste?schema=public"
