# Copie este arquivo para ".env" e preencha com os valores reais do seu ambiente.
# NUNCA coloque valores reais aqui: este arquivo vai para o Git. O ".env" está no .gitignore.

# ---------------------------------------------------------------------------
# Execução local (npm run start:dev)
# ---------------------------------------------------------------------------

# String de conexão do PostgreSQL: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/emprestimo_equipamentos?schema=public"

# Porta da API (padrão 3000)
PORT=3000

# development | test | production. Em production o Swagger fica desligado.
NODE_ENV=development

# Chave que assina os tokens JWT. OBRIGATÓRIA, mínimo 32 caracteres, e não pode ser este exemplo.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Duração do token de acesso (curta de propósito) e validade do refresh token, em dias
JWT_EXPIRA_EM=15m
REFRESH_DIAS=7

# Custo do bcrypt (4 a 15). Maior = mais seguro e mais lento. Padrão 12.
BCRYPT_CUSTO=12

# Origens de navegador autorizadas a chamar a API, separadas por vírgula. Vazio = nenhuma.
# Ex.: CORS_ORIGENS=https://meu-front.com,http://localhost:4200
CORS_ORIGENS=

# Documentação interativa em /docs. Padrão: ligada fora de produção, desligada em produção.
# SWAGGER_ATIVO=true

# ---------------------------------------------------------------------------
# Primeiro administrador (npm run seed). Não existe senha padrão: sem estas variáveis o seed não roda.
# ADMIN_SENHA precisa ter 12+ caracteres, com letras e números.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=Administrador

# ---------------------------------------------------------------------------
# Docker (docker compose up -d --build)
# ---------------------------------------------------------------------------
DB_USER=postgres
DB_SENHA=
DB_NOME=emprestimo_equipamentos
PORTA_API=3000

# ---------------------------------------------------------------------------
# Testes de integração (npm run test:e2e)
# Banco EXCLUSIVO para testes: o nome PRECISA conter "test" ou "teste". As tabelas são zeradas a cada execução.
# ---------------------------------------------------------------------------
DATABASE_URL_TESTE="postgresql://postgres:sua_senha@localhost:5432/emprestimo_teste?schema=public"
