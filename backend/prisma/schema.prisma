// Modelo de dados do sistema de empréstimo de equipamentos.
//
// ATENÇÃO: duas regras de integridade vivem em SQL puro, dentro da migration
// 20261001120000_seguranca_e_integridade, porque o Prisma não as representa:
//   1. índice único PARCIAL: no máximo UM empréstimo ATIVO por equipamento;
//   2. CHECK: o e-mail do usuário é sempre gravado em minúsculas.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum StatusEmprestimo {
  ATIVO
  DEVOLVIDO
}

model Usuario {
  id           Int            @id @default(autoincrement())
  nome         String
  email        String         @unique // sempre minúsculo (ver CHECK na migration)
  senhaHash    String // hash bcrypt: a senha em si nunca é guardada
  role         Role           @default(USER)
  ativo        Boolean        @default(true) // conta desativada não entra nem usa tokens antigos
  // Dados de perfil (todos opcionais). CPF, telefone e CEP são guardados só com dígitos.
  cpf          String?        @unique
  telefone     String?
  cep          String?
  logradouro   String?
  numero       String?
  complemento  String?
  bairro       String?
  cidade       String?
  uf           String?
  avatar       String? // "animal:<nome>" (acervo) ou data URL de imagem enviada (png/jpeg/webp, pequena)
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @default(now()) @updatedAt
  emprestimos  Emprestimo[]
  refreshTokens RefreshToken[]
  recuperacoesSenha RecuperacaoSenha[]
}

model Equipamento {
  id           Int          @id @default(autoincrement())
  nome         String
  descricao    String?
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @default(now()) @updatedAt
  emprestimos  Emprestimo[]
  // "emprestado" NÃO é uma coluna: é derivado da existência de um empréstimo ATIVO,
  // para o estado ter uma única fonte da verdade e nunca divergir.
}

model Emprestimo {
  id             Int              @id @default(autoincrement())
  usuarioId      Int
  usuario        Usuario          @relation(fields: [usuarioId], references: [id])
  equipamentoId  Int
  equipamento    Equipamento      @relation(fields: [equipamentoId], references: [id])
  status         StatusEmprestimo @default(ATIVO)
  dataRetirada   DateTime         @default(now())
  prazoDevolucao DateTime // combinado na retirada; passou disso e ainda ATIVO = atrasado
  dataDevolucao  DateTime?
  // Controle das notificações por e-mail: guardam QUANDO o aviso saiu, para não repetir (e para duas instâncias
  // da API não avisarem a mesma pessoa duas vezes: quem grava primeiro, envia)
  lembreteEnviadoEm   DateTime?
  ultimoAvisoAtrasoEm DateTime?

  @@index([usuarioId, status])
  @@index([equipamentoId, status])
}

// Sessões renováveis. Guarda só o HASH do token (como uma senha): quem lê o banco não consegue usá-lo.
model RefreshToken {
  id          Int       @id @default(autoincrement())
  usuarioId   Int
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  criadoEm    DateTime  @default(now())
  expiraEm    DateTime
  revogadoEm  DateTime? // preenchido ao renovar (rotação), sair ou trocar a senha

  @@index([usuarioId])
}

// Pedidos de "esqueci minha senha". Como o refresh token, só o HASH do token vai para o banco: quem lê a
// tabela não consegue redefinir a senha de ninguém. Uso único e validade curta.
model RecuperacaoSenha {
  id        Int       @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  criadoEm  DateTime  @default(now())
  expiraEm  DateTime
  usadoEm   DateTime? // preenchido ao redefinir a senha ou quando um pedido mais novo substitui este

  @@index([usuarioId, criadoEm])
}

// Trilha de auditoria: quem fez o quê e quando. O nome de quem agiu fica gravado junto (não é chave estrangeira):
// o registro continua legível mesmo depois de a conta ser anonimizada.
model RegistroAuditoria {
  id         Int      @id @default(autoincrement())
  criadoEm   DateTime @default(now())
  atorId     Int?
  atorNome   String?
  acao       String
  entidade   String
  entidadeId Int?
  detalhes   Json?

  @@index([criadoEm])
  @@index([acao, criadoEm])
  @@index([atorId, criadoEm])
}
